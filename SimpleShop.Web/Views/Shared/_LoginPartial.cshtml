@using Microsoft.AspNetCore.Identity
@using Model.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isSignedIn = SignInManager?.IsSignedIn(User) ?? false;
    ApplicationUser currentUser = null;
    var isAdmin = false;

    if (isSignedIn)
    {
        currentUser = await UserManager.GetUserAsync(User);

        if (currentUser != null)
        {
            // You can keep using User.IsInRole("Admin") if you prefer
            isAdmin = await UserManager.IsInRoleAsync(currentUser, "Admin");
        }
    }
}

@if (isSignedIn && currentUser != null)
{
    if (isAdmin)
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" id="navbarDropdown_3">
                Hello, @currentUser.FirstName @currentUser.LastName !
            </a>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                <a asp-controller="Profile" asp-action="Index" class="dropdown-item">Profile</a>
                <a asp-controller="Users" asp-action="Index" class="dropdown-item">Manage users</a>
                <a asp-controller="Product" asp-action="Index" class="dropdown-item">Manage products</a>
                <a asp-controller="Category" asp-action="Index" class="dropdown-item">Manage categories</a>
                <a asp-controller="Manufacturer" asp-action="Index" class="dropdown-item">Manage manufacturers</a>
                <a asp-controller="Order" asp-action="OrderList" class="dropdown-item">Manage orders</a>
                <a asp-controller="Account" asp-action="Logout" class="dropdown-item">Logout</a>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" id="navbarDropdown_3">
                Привіт, @currentUser.FirstName @currentUser.LastName !
            </a>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                <a asp-controller="Profile" asp-action="Index" class="dropdown-item">Profile</a>
                <a asp-controller="WishList" asp-action="Index" class="dropdown-item">WishList</a>
                <a asp-controller="Order" asp-action="OrderList" class="dropdown-item">Purchases</a>
                <a class="dropdown-item" href="#">Review</a>
                <a asp-controller="Account" asp-action="Logout" class="dropdown-item">Logout</a>
            </div>
        </li>
    }
}
else
{
    <li class="nav-item">
        <a asp-controller="Account" asp-action="Login" class="nav-link">Login</a>
    </li>
}
